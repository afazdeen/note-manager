# Copy to .env and adjust. Real environment variables take priority over .env.

# Address to listen on: an IP address or localhost. There is no authentication,
# so the default lets only this machine connect. 0.0.0.0 opens it to your network.
HOST=127.0.0.1

# HTTP port (1-65535).
PORT=8080

# The only browser origin allowed to call /api (scheme, host and port; no path).
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Load demo notes on start (true/false).
SEED_NOTES=true
